GITHUB_OAUTH_CLIENT_ID=your_client_id_here
GITHUB_OAUTH_CLIENT_SECRET=your_client_secret_here
SESSION_SECRET=change_me_to_a_random_string
JIRA_EMAIL=your_jira_email@redhat.com
JIRA_API_TOKEN=your_jira_api_token

# Dev only: your CORS proxy URL (e.g. https://your-proxy.workers.dev). When set,
# `vite dev` registers a same-origin /_jiraproxy route so localhost can reach
# Jira without the proxy's CORS allowlist rejecting it. Leave unset in prod.
# JIRA_PROXY=https://your-proxy.workers.dev
