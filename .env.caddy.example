# =============================================================================
# Konveyor Board - Caddy Proxy Configuration
# =============================================================================
# Copy this file to .env.caddy and fill in your credentials:
#   cp .env.caddy.example .env.caddy
#
# Then run:
#   docker compose up        (or: podman compose up)
# =============================================================================

# -----------------------------------------------------------------------------
# GitHub Personal Access Token (required)
# -----------------------------------------------------------------------------
# Create a fine-grained token at:
#   https://github.com/settings/personal-access-tokens/new
#
# Required permissions:
#   - Repository access: All repositories (or select the repos in the org)
#   - Repository permissions:
#       Issues:        Read and write
#       Metadata:      Read-only (automatically selected)
#   - Organization permissions:
#       Projects:      Read and write
#       Members:       Read-only
#
# Alternatively, create a classic token at:
#   https://github.com/settings/tokens/new
#
# Required scopes for classic tokens:
#   - repo        (full control of private repositories)
#   - project     (full control of projects)
#   - read:org    (read organization membership)
#
GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# Jira Configuration (optional - for Jira ticket integration)
# -----------------------------------------------------------------------------
# Base URL of your Jira Cloud instance (no trailing slash).
# Default: https://redhat.atlassian.net
#
JIRA_URL=https://redhat.atlassian.net

# Jira account email address
#
JIRA_EMAIL=

# Jira API token - create one at:
#   https://id.atlassian.com/manage-profile/security/api-tokens
#
# The token inherits your account's project permissions. No extra scopes needed;
# it just needs read access to the Jira projects configured in dashboard-config.json.
#
JIRA_API_TOKEN=
